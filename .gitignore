# Local Salesforce CLI / SFDX state
.sf_cli_project/
.sfdx/
.sf/

# Salesforce CLI command output dumped at the repo root (org lists, metadata
# listings, deploy reports): local scratch data, never part of the tool.
/orglist.json
/md_*.json
/dryrun*.json
/deploy*.json

# Throwaway scripts kept at the repo root to regenerate a single report page
# from the last retrieve, without replaying a full analysis.
/regen_*.py

# Local SFDX projects used to fix or deploy an org from this workspace
/smatch-org/
/smatch-fix/

# Data Dictionary workbooks exported for a client (org data, not committed)
/*.xlsx

# Generated outputs
output_test/
excel/
objects/
apex/
flows/
assets/
index.html

# ...but keep the source HTML assets package (not a generated output dir)
!src/reporting/html/assets/
!src/reporting/html/assets/*.py

# Local project backups and retrieved Salesforce metadata (never committed)
# Any top-level folder ending with an 8-digit date suffix (YYYYMMDD) is treated
# as a per-org retrieve and is excluded from version control.
backup/
/*[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/

# Reference CSV imported from external tooling (not used at runtime)
static_code_analysis_rules.csv

# OS / editor
.DS_Store
Thumbs.db
.vs/
.vscode/
.idea/

# Local user manual (generated separately, not committed)
Salesforce Manuel utilisateur.rtf

