                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;div class=&quot;roundedboxarticle&quot;&gt; 
&lt;div&gt;
    &lt;img class=&quot;titreboule&quot; style=&quot;margin-right:15px&quot; src=&quot;https://digitalm--xrmform11--c.documentforce.com/sfc/servlet.shepherd/version/renditionDownload?rendition=ORIGINAL_Png&amp;amp;versionId=0681x000001RCRe&amp;amp;operationContext=CHATTER&amp;amp;contentId=05T1x000004ZoOy&quot; alt=&quot;bénéfices&quot;&gt;
    &lt;h3&gt;Qu&apos;est-ce qu&apos;un mapping dans Marketing Cloud ? &lt;/h3&gt; &lt;/div&gt;
&lt;div&gt;&lt;br&gt;
    Le mapping est &lt;span class =&quot;bluebold&quot;&gt; le lien entre les données des Data Extensions et des Activités.&lt;/span&gt; 
    &lt;br&gt;Pour que les activités se déclenchent correctement, &lt;span class =&quot;bluebold&quot;&gt;un bon mapping est indispensable.&lt;/span&gt;
  &lt;br&gt;&lt;br&gt;Chaque activité doit être mappée : 
    &lt;ul&gt;
        &lt;li&gt;  &lt;span class =&quot;bluebold&quot;&gt;Membres de campagne :&lt;/span&gt;  permet d&apos;associer la cible à la campagne créée dans Sales et de qualifier la cible en tant que &quot;Membres&quot;&lt;/li&gt;
        &lt;li&gt;  &lt;span class =&quot;bluebold&quot;&gt;Email :&lt;/span&gt;  permet d&apos;utiliser les champs de personnalisation (nom, prénom, conseiller...)&lt;/li&gt;
        &lt;li&gt;  &lt;span class =&quot;bluebold&quot;&gt;Tâche :&lt;/span&gt;  permet de faire le lien entre le membre et la tâche, et de définir les informations de la tâches (date, priorité...)&lt;/li&gt;
        &lt;li&gt;  &lt;span class =&quot;bluebold&quot;&gt;Courrier :&lt;/span&gt;  permet de faire le lien entre le membre et le courrier, et de définir les informations du courrier (date d&apos;envoi, nombre de documents...). L&apos;envoi physique du courrier ne sera pas déclenché par cette activité.&lt;/li&gt;
    &lt;/ul&gt;
    &lt;/div&gt;</value>
                </componentInstanceProperties>
                <componentName>forceCommunity:htmlBlock</componentName>
                <identifier>forceCommunity_htmlBlock3</identifier>
            </componentInstance>
