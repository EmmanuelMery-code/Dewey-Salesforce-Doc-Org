            <componentInstance>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;div class=&quot;roundedboxarticle&quot;&gt; 
&lt;div&gt;
      &lt;div class=&quot;question&quot;&gt;
          &lt;strong&gt;Sur mon PAC, je vois “Mes campagnes à valider”.&lt;/strong&gt;
              &lt;h2&gt;Que dois-je valider ?&lt;/h2&gt;
    &lt;/div&gt;&lt;br&gt;
      &lt;div class=&quot;container&quot;&gt;
        &lt;div class=&quot;truth&quot; tabindex=&quot;2&quot;&gt;
          &lt;span class=&quot;bluebold&quot;&gt;2. A quels clients/prospects je souhaite faire parvenir la campagne&lt;/span&gt;
          &lt;br&gt;&lt;br&gt;&lt;br&gt;
            &lt;i&gt;Cet élément de votre page PAC liste le nombre de campagne pour lesquels on attend une action de votre part, celle de valider quels clients/prospects recevront la campagne. Comme d’habitude, vous pouvez consulter le contenu de la campagne dans Reflexpac.&lt;/i&gt;
        &lt;br&gt;&lt;br&gt;&lt;div class=&quot;button&quot;&gt; ← Retour
          &lt;/div&gt;
          &lt;/div&gt;
        &lt;div class=&quot;possibilities&quot; tabindex=&quot;1&quot;&gt;
            &lt;ol&gt;
              &lt;li&gt;Le contenu des emails liés aux campagnes&lt;/li&gt;
              &lt;li&gt;La liste des clients/prospects je souhaite faire parvenir la campagne&lt;/li&gt;
              &lt;li&gt;Les dates de la campagne pour mes clients/prospects&lt;/li&gt;
            &lt;/ol&gt;
                &lt;br&gt;&lt;div class=&quot;button&quot;&gt; Réponse
          &lt;/div&gt; 
          &lt;/div&gt; 
    &lt;/div&gt;
    &lt;/div&gt;</value>
