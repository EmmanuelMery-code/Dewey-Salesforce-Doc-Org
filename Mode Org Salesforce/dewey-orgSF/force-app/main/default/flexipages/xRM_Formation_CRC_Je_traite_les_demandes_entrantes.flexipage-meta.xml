        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h4&gt;Premier cas : Je détecte une opportunité &lt;/h4&gt;
&lt;br&gt;&lt;strong&gt;C’est un Lead : &lt;/strong&gt;
&lt;ol&gt;
    &lt;li&gt;Je transfère l’appel à la VAD    &lt;/li&gt;
    &lt;li&gt;En parrallèle, &lt;a href=&quot;/s/parcours-vad/vad-creation-lead&quot;&gt;&lt;span class=&quot;textlink&quot;&gt;je modifie le propriétaire du Lead &lt;/span&gt;&lt;/a&gt;pour l’affecter soit au Conseiller qui récupère l’appel, soit aux assistants VAD en cas d’indisponibilité&lt;/li&gt;
&lt;/ol&gt;

&lt;br&gt;&lt;strong&gt;C’est client/prospect confié à la VAD ou n’est pas confié: &lt;/strong&gt;
&lt;ol&gt;
    &lt;li&gt;Je transfère l’appel à la VAD    &lt;/li&gt;
    &lt;li&gt;&lt;span class=&quot;bluebold&quot;&gt;Je crée une tâche VAD&lt;/span&gt; sur sa fiche Compte, en l’attribuant au Conseiller qui récupère l’appel, ou aux assistants VAD en cas d’indisponibilité&lt;/li&gt;
&lt;/ol&gt;
&lt;span class=&quot;redtext&quot;&gt;/!\ C’est très important d’utiliser la bonne tâche (DP ou VAD) en fonction du confié / suiveur, sinon le conseiller ne la verra pas&lt;/span&gt;


 &lt;br&gt;
&lt;br&gt;&lt;strong&gt;C’est client/prospect confié au Réseau : &lt;/strong&gt;
&lt;ol&gt;
    &lt;li&gt;&lt;span class=&quot;bluebold&quot;&gt;Je crée une tâche DP de type Appel &lt;/span&gt;sur sa fiche Compte, et l’attribue au Conseiller de la Distribution Physique. Je mets l’échéance de la tâche à J+1 ouvré&lt;/li&gt;
    &lt;li&gt;Je note au sein de la tâche les préférences du client/prospect, et mets à jour ses préférences sur sa fiche Compte dans le sous-menu “Coordonées de résidence”&lt;/li&gt;
    &lt;li&gt;De plus, je notifie le Conseiller sur la Chatter du Compte en le &lt;strong&gt;@mentionnant&lt;/strong&gt;&lt;/li&gt;
&lt;/ol&gt;</value>
                </componentInstanceProperties>
                <componentName>forceCommunity:htmlBlock</componentName>
                <identifier>forceCommunity_htmlBlock7</identifier>
            </componentInstance>
        </itemInstances>
