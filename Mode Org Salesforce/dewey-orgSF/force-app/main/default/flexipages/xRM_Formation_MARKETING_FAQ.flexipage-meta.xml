            <componentInstance>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h4&gt;&quot;Comment puis-je accéder à Marketing Cloud ?&quot;&lt;/h4&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(77, 81, 86); font-size: 14px;&quot;&gt;→ &lt;/span&gt;Depuis la gauche de l&apos;écran xRM Sales, dans le &quot;gauffrier&quot;, sélectionner Marketing Cloud. S&apos;assurer d&apos;être connecté à ALM Production.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Pour plus d&apos;informations, consultez l&apos;article Marketing Cloud, &lt;/span&gt;&lt;a href=&quot;/xrmformation/s/marketing-parcours-/marketing-je-decouvre-mc&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;color: rgb(0, 0, 0);&quot;&gt;ici&lt;/a&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;h4&gt;&quot;Dans MC, comment revenir en arrière ou accéder au menu ?&quot;&lt;/h4&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(77, 81, 86); font-size: 14px;&quot;&gt;→ Cliquez sur le nuage en haut à gauche&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;</value>
