        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;h4&gt;&quot;Campagne &quot;réglementaire&quot; / &quot;légale&quot; : comment ça va se passer dans xRM ?&quot;&lt;/h4&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(77, 81, 86); font-size: 14px;&quot;&gt;→ &lt;/span&gt;Lors d&apos;une campagne légale/réglementaire une tâche marketing d&apos;origine &quot;légale&quot; viendra se positionner sur le compte.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Exemple de campagne qui vont générer des tâches légales : ILR (Imprimé de Liquidation Retraite) / recyclage, DDA&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;h4&gt;&quot;Est ce que les conseillers peuvent ajouter des membres dans un kit à partir d&apos;un rapport ?&quot;&lt;/h4&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(77, 81, 86);&quot;&gt;→ Oui l&lt;/span&gt;es conseillers peuvent ajouter des membres manuellement (un à un) ou bien depuis un rapport : l&apos;ajout dans un KIT déclenche automatiquement l&apos;envoi immédiat via MC.&lt;/p&gt;&lt;p&gt;Seuls le RMR ou CMN peuvent créer des rapports.&lt;/p&gt;&lt;p&gt;On peut mettre des rapports à disposition des conseillers et ils pouront ajouter les membres depuis un rapport. Dans ce cas l&apos;ensemble des personnes dans le rapport sont ajoutées au kit de communication. A noter que les rapports sont basés sur les données dans xRM, qui à ce jour, ne sont pas aussi riches que dans SIC (notamment sur les contrats)&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;h4&gt;&quot;Qui va fabriquer des kits de campagne ?&quot;&lt;/h4&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(77, 81, 86);&quot;&gt;→&amp;nbsp;&amp;nbsp;&lt;/span&gt;Les CMN ou RMR vont être en capacité de créer des kit de campagne national pour local.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;h4&gt;&quot;Si je créé une campagne dans xRM, est-elle visible dans SIC ?&quot;&lt;/h4&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(77, 81, 86);&quot;&gt;→ &lt;/span&gt;Non, les campagnes dans xRM sont isolées de SIC.&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>forceCommunity:richTextInline</componentName>
                <identifier>forceCommunity_richTextInline3</identifier>
            </componentInstance>
        </itemInstances>
