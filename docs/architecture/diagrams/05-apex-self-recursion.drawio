<mxfile host="app.diagrams.net" type="device">
  <diagram id="dewey-self-recursion" name="APEX-REL-002 self-recursion">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="APEX-REL-002 — Apex self-recursion detection: three successive filters, with an abstention policy" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1050" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="src/analyzer/apex_analyzer_helpers.py :: _detect_self_recursive_methods" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="700" height="24" as="geometry" />
        </mxCell>

        <mxCell id="p0" value="Apex class body" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="80" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="_strip_comments_and_strings(body, keep_string_markers=True)&lt;br&gt;finite state machine — blanks comments and string contents,&lt;br&gt;keeps the quotes so that f('a') is not read as f()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="360" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="_extract_method_bodies(clean)&lt;br&gt;regex headers + brace-depth counting&lt;br&gt;→ ApexMethod(name, param_types, params_raw, body)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="256" width="360" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="_find_recursion_guards(clean)&lt;br&gt;candidate guards = static non-final Boolean / Integer / Set&amp;lt;&amp;gt; / Map&amp;lt;&amp;gt; fields&lt;br&gt;+ tell-tale names (isRunning, bypass, recursionGuard, TriggerBypass.skipAll…)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="352" width="360" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="for each method with len(name) &amp;gt;= 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="448" width="280" height="40" as="geometry" />
        </mxCell>

        <mxCell id="fc" value="FILTER (c) — guard&lt;br&gt;&lt;br&gt;_body_is_guarded(method.body, guards)&lt;br&gt;Does THIS method actually READ a guard&lt;br&gt;in an if / while, or via contains( ?&lt;br&gt;&lt;br&gt;A field declared but never tested protects nothing.&lt;br&gt;Evaluated per method: a guard set in another&lt;br&gt;method does not excuse this one." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="470" y="120" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="fa" value="FILTER (a) — receiver&lt;br&gt;&lt;br&gt;_is_self_invocation(body, call_start, class_name)&lt;br&gt;&lt;br&gt;COUNTS:  method(...)   ·   this.method(...)   ·   MyClass.method(...)&lt;br&gt;IGNORED: new AccountService().method(...)  ·  svc.method(...)&lt;br&gt;&lt;br&gt;A same-named method on another class or instance&lt;br&gt;is a different implementation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="470" y="300" width="360" height="172" as="geometry" />
        </mxCell>
        <mxCell id="fb" value="FILTER (b) — signature&lt;br&gt;&lt;br&gt;_call_targets_same_signature(target, overloads, args, known_types)&lt;br&gt;&lt;br&gt;1. arity must match the enclosing method&lt;br&gt;2. if several overloads share that arity, compare inferred types&lt;br&gt;   _infer_argument_type: literals, new X(), casts,&lt;br&gt;   local declarations, the method's own parameters&lt;br&gt;3. any type returns None → ABSTAIN (report nothing)&lt;br&gt;&lt;br&gt;So sync(id) → sync(id, false) is delegation, not recursion." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="470" y="480" width="360" height="212" as="geometry" />
        </mxCell>

        <mxCell id="dg" value="guard read&lt;br&gt;in this method?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="150" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dr" value="self-invocation?&lt;br&gt;(receiver)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="330" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ds" value="same signature?&lt;br&gt;(arity + types)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="525" width="170" height="90" as="geometry" />
        </mxCell>

        <mxCell id="skip" value="skip this method&lt;br&gt;(no finding)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1080" y="270" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nextcall" value="next call site&lt;br&gt;/ next method" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1080" y="440" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="emit" value="REPORT the finding&lt;br&gt;recursive.add(method.signature)&lt;br&gt;e.g. walk(Id, Integer) — not just &quot;walk&quot;,&lt;br&gt;because with overloads a name does not&lt;br&gt;identify an implementation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="700" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="callloop" value="for each match of \b{name}\s*\( inside method.body" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="520" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="args" value="_call_arguments(body, paren_index)&lt;br&gt;balanced-paren walk, then _split_top_level&lt;br&gt;(respects (), [], {} and generics &amp;lt;&amp;gt;)&lt;br&gt;unbalanced → skip this call site" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="out" value="sorted list of offending signatures&lt;br&gt;→ one Finding per Apex class" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="710" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="note-trig" value="TRIG-REL-001 reuses filter (c): an after insert/update trigger doing DML on Trigger.new (or an alias) is reported only if the trigger body does not read a reentrancy guard — same _body_is_guarded logic." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1170" height="46" as="geometry" />
        </mxCell>
        <mxCell id="note-design" value="Design principle: the analyzer is lexical — no AST, no data-flow analysis. Every filter is therefore written to be conservative, and an undecidable case makes the rule stay silent rather than guess. A rule that cries wolf gets switched off, and a rule nobody trusts is worth less than no rule at all." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;align=left;spacingLeft=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="1170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="z0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p0" target="p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p2" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;" edge="1" parent="1" source="p4" target="dg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="dg" target="skip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="dg" target="dr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="dr" target="nextcall">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="dr" target="ds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z9" value="no / undecidable&lt;br&gt;(abstain)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="ds" target="nextcall">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="570" />
              <mxPoint x="860" y="680" />
              <mxPoint x="1150" y="680" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="z10" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="ds" target="emit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="p4" target="callloop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="callloop" target="args">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="emit" target="out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
