<mxfile host="app.diagrams.net" type="device">
  <diagram id="dewey-mode-b" name="Mode B pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Mode B — assess.py: configuration comes from Salesforce, results go back to Salesforce" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1000" height="34" as="geometry" />
        </mxCell>

        <mxCell id="org" value="Salesforce org (--org, default ag2rPoc)" style="rounded=0;html=1;fillColor=#fef7e0;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#8a6d00;" vertex="1" parent="1">
          <mxGeometry x="820" y="55" width="390" height="640" as="geometry" />
        </mxCell>
        <mxCell id="cfg-obj" value="Configuration objects (read)&lt;br&gt;&lt;br&gt;DeweyRule__c — rule definitions&lt;br&gt;DeweyConfig__c — thresholds &amp;amp; weights&lt;br&gt;DeweyExclusion__c — per-component exclusions" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="850" y="100" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="res-obj" value="Result objects (written per run)&lt;br&gt;&lt;br&gt;OrgAnalysis__c — scores, counts, status&lt;br&gt;Finding__c — one per violation,&lt;br&gt;   with IsNew__c / IsResolved__c&lt;br&gt;AnalysisDelta__c — diff vs previous run&lt;br&gt;DeweyPosture__c — adoption posture" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="850" y="430" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cov-obj" value="Tooling API (optional --coverage)&lt;br&gt;ApexCodeCoverageAggregate, FlowTestCoverage" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="270" width="330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b0" value="assess.py&lt;br&gt;--org  --source  --branch  --scope  --analyzer&lt;br&gt;--pmd-ruleset  --coverage  --run-tests" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="1 — SfConfigService(org)&lt;br&gt;`sf data query` → RuleCatalog built from the org,&lt;br&gt;not from rules.xml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="2 — Resolve the source&lt;br&gt;local SFDX path, or&lt;br&gt;`git clone --depth 1` into a temp dir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="330" height="62" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="3 — Optional: run_apex_tests&lt;br&gt;then fetch_test_coverage (sf CLI)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="330" height="52" as="geometry" />
        </mxCell>

        <mxCell id="orch" value="4 — HeadlessOrchestrator.run()" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="380" height="440" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="parse → MetadataSnapshot&lt;br&gt;(same parser as Mode A)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="186" width="340" height="46" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="compute_adoption_stats(snapshot)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="246" width="340" height="38" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="apply_test_coverage(...) if supplied" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="298" width="340" height="38" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="AnalyzerEngine.analyze_snapshot()&lt;br&gt;→ AnalyzerReport" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="420" y="350" width="340" height="46" as="geometry" />
        </mxCell>
        <mxCell id="h5" value="--analyzer pmd | sfca&lt;br&gt;inject external violations as extra Findings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="410" width="340" height="46" as="geometry" />
        </mxCell>
        <mxCell id="h6" value="filter by --scope&lt;br&gt;(all | apex | flows | security | omni)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="470" width="340" height="46" as="geometry" />
        </mxCell>
        <mxCell id="h7" value="AssessmentResult(snapshot, report, scope)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="420" y="530" width="340" height="38" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="5 — SfFindingsService.push(...)&lt;br&gt;&lt;br&gt;reuse existing Finding__c records&lt;br&gt;create the genuinely new ones&lt;br&gt;mark vanished ones as resolved&lt;br&gt;→ (analysis_id, delta_summary)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="620" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="6 — Print the terminal summary&lt;br&gt;global score, top 5 critical findings, delta&lt;br&gt;then rmtree the temp clone" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="330" height="62" as="geometry" />
        </mxCell>

        <mxCell id="note1" value="No report writers, no Tkinter, no SQLite history: Mode B reuses the parser, the analyzer engine and the shared models, and replaces the whole presentation layer with Salesforce Custom Objects." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;align=left;spacingLeft=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="740" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="Mode B never retrieves metadata from the org: it analyzes a local or freshly cloned DX tree. The `sf` CLI is used only for configuration SOQL, coverage and Apex tests." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;fontSize=11;align=left;spacingLeft=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="820" y="715" width="390" height="85" as="geometry" />
        </mxCell>

