<mxfile host="app.diagrams.net" type="device">
  <diagram id="dewey-mode-a" name="Mode A pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Mode A — SalesforceDocumentationGenerator.generate(): 11 synchronous steps on a worker thread" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1000" height="34" as="geometry" />
        </mxCell>

        <mxCell id="laneA" value="UI thread — Tkinter" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=center;fontStyle=1;fontSize=13;fontColor=#555555;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="300" height="800" as="geometry" />
        </mxCell>
        <mxCell id="laneB" value="Worker thread — daemon, synchronous pipeline" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=center;fontStyle=1;fontSize=13;fontColor=#555555;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="50" width="450" height="800" as="geometry" />
        </mxCell>
        <mxCell id="laneC" value="Artifacts written to disk" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=center;fontStyle=1;fontSize=13;fontColor=#555555;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="830" y="50" width="430" height="800" as="geometry" />
        </mxCell>

        <mxCell id="u1" value="app.py → Application (tk.Tk)&lt;br&gt;8 mixins: UI, settings, language,&lt;br&gt;SF CLI, doc task, generation, CLI, AI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="260" height="66" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="TaskManager.start_task(...)&lt;br&gt;refuses if a worker is alive" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="186" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="Queue&lt;br&gt;(&quot;log&quot;, &quot;done&quot;, &quot;error&quot;)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="105" y="280" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="u4" value="Application.after(150, poll_queue)&lt;br&gt;drains the queue on the Tk thread" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="u5" value="log pane + progress&lt;br&gt;+ success / error dialog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="472" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="u6" value="Every downstream module receives&lt;br&gt;log_callback = task_manager.queue_log.&lt;br&gt;That is why the parser and the&lt;br&gt;orchestrator never import Tkinter." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;align=left;spacingLeft=8;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="260" height="76" as="geometry" />
        </mxCell>
        <mxCell id="u7" value="app.py --action X --silent&lt;br&gt;hides the window, runs the same&lt;br&gt;pipeline synchronously, then&lt;br&gt;sys.exit(app.cli_exit_code)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=10;align=left;spacingLeft=8;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="260" height="76" as="geometry" />
        </mxCell>

