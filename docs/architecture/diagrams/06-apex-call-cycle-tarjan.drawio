<mxfile host="app.diagrams.net" type="device">
  <diagram id="dewey-tarjan" name="APEX-REL-003 Tarjan SCC">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="APEX-REL-003 — call cycles between Apex classes: Tarjan's strongly connected components" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1050" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="src/analyzer/engine_call_graph.py :: _detect_apex_call_cycles → _find_cycles" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="700" height="24" as="geometry" />
        </mxCell>

        <mxCell id="ph1" value="Phase 1 — build the graph (a heuristic over-approximation)" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="560" height="380" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="keep Apex artifacts with kind == &quot;class&quot;&lt;br&gt;(triggers excluded); require &amp;gt;= 2 class names" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="108" width="520" height="46" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="_strip_comments_and_strings(artifact.body)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="IDENTIFIER_RE.findall(stripped), keep those matching a known class name&lt;br&gt;mentioned.discard(artifact.name)  ← removes self-references" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="224" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="graph: dict[str, set[str]]  —  ClassName → {referenced ClassName}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="Caveat worth stating in any report: an edge means &quot;class A mentions class B somewhere in its source&quot;, including a type declaration or a variable type — not &quot;a method of A calls a method of B&quot;. The graph over-approximates the real call graph, so a reported cycle means the classes reference each other, not that they call each other at runtime." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="344" width="520" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ph2" value="Phase 2 — Tarjan SCC: one depth-first pass, O(V + E)" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="630" y="70" width="580" height="380" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="state per node: index (discovery order) · lowlink (lowest index reachable)&lt;br&gt;plus an explicit stack and an on_stack map" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="108" width="540" height="46" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="strongconnect(node): assign index = lowlink = counter++, push, mark on_stack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="170" width="540" height="38" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="for each neighbour:&lt;br&gt;   unvisited → recurse, then lowlink[node] = min(lowlink[node], lowlink[neighbour])&lt;br&gt;   on the stack → lowlink[node] = min(lowlink[node], index[neighbour])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="224" width="540" height="62" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="lowlink[node] == index[node]  →  node is an SCC root:&lt;br&gt;pop the stack down to node, that popped set is one component" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="650" y="302" width="540" height="46" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="emit the component if len &amp;gt;= 2.&lt;br&gt;The len == 1 self-loop branch is dead code: discard(artifact.name) in phase 1 means no node ever has an edge to itself." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="364" width="540" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ph3" value="Worked example" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="475" width="560" height="290" as="geometry" />
        </mxCell>
        <mxCell id="nA" value="AccountService" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="540" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nB" value="ContactService" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="540" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nC" value="OrderService" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="650" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nD" value="Utils" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="650" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eAB" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="nA" target="nB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eBC" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="nB" target="nC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eCA" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="nC" target="nA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eBD" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#999999;" edge="1" parent="1" source="nB" target="nD">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="exnote" value="SCC = {AccountService, ContactService, OrderService} → size 3, reported.&lt;br&gt;Utils has no path back, so it is not part of any component." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="718" width="520" height="44" as="geometry" />
        </mxCell>

        <mxCell id="ph4" value="Output — one Finding per class in the cycle" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="630" y="475" width="580" height="290" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="for each class in the sorted component:&lt;br&gt;   message = &quot;forms a call cycle with the other members&quot;&lt;br&gt;   details  = the member list + the chain label&lt;br&gt;                 A -&amp;gt; B -&amp;gt; C -&amp;gt; A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="512" width="540" height="76" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="returned as dict[class name → list[Finding]], which the engine merges&lt;br&gt;into AnalyzerReport.apex and re-sorts by (severity, rule id)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="604" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="Why Tarjan rather than enumerating cycles? Tarjan finds every strongly connected component in a single DFS pass, linear in nodes plus edges. Enumerating individual cycles (Johnson's algorithm) is exponential in the number of cycles and would report the same tangle of classes many times over. One SCC per tangle is also the more actionable output." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=11;align=left;spacingLeft=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="650" y="670" width="540" height="84" as="geometry" />
        </mxCell>

        <mxCell id="w1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="g1" target="g2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="g2" target="g3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="g3" target="g4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="_find_cycles(graph)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="g4" target="t1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="t1" target="t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="t2" target="t3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="t3" target="t4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="t4" target="o1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="o1" target="o2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
